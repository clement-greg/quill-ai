<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Quill AI</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Other names Siri accepts for the app, so "save a thought in Quill" works too.
	     The hints steer speech recognition away from similar words (e.g. "Quinn"). -->
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Quill</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>kwill</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Quill A I</string>
			<key>INAlternativeAppNamePronunciationHint</key>
			<string>kwill ay eye</string>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- iPhone: portrait only. iPad keeps every orientation (multitasking needs it). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets Simulator builds reach the local dev server (http://localhost:6258). -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Quill AI uses the camera when you add a photo to a chat or an entity.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Quill AI uses your photos when you add one to a chat or an entity.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Quill AI uses the microphone when you dictate to Ask Quill.</string>
	<key>NSSiriUsageDescription</key>
	<string>Siri can save thoughts to Quill AI and answer questions about your story.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Quill AI turns your dictation into text for Ask Quill.</string>
</dict>
</plist>
